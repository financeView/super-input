<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.superinput.rerank</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@PROJECT_ROOT@@/.venv/bin/uvicorn</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>47625</string>
    <string>--factory</string>
    <string>rerank.service:_create_prod_app</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@@PROJECT_ROOT@@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>@@PROJECT_ROOT@@/src</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/tmp/superinput-rerank.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/superinput-rerank.err</string>
</dict>
</plist>
